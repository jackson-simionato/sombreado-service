#!/usr/bin/env bash
# Root-owned fixed-path activator installed at /usr/local/sbin/sombreado-deploy-release.
# Validates RELEASE_SHA, then runs the root-owned deploy-release implementation.
# Sudoers must point only at this path — never at user-writable release trees.

set -euo pipefail

SOMBREADO_DEPLOY_LIB="${SOMBREADO_DEPLOY_LIB:-/usr/local/lib/sombreado}"
RELEASE_SHA="${1:-${RELEASE_SHA:-}}"

if [[ -z "${RELEASE_SHA}" ]]; then
  echo "usage: sombreado-deploy-release <release-sha>" >&2
  exit 1
fi

if [[ ! "${RELEASE_SHA}" =~ ^[0-9a-f]{7,64}$ ]]; then
  echo "invalid RELEASE_SHA (expected 7-64 lowercase hex): ${RELEASE_SHA}" >&2
  exit 1
fi

DEPLOY_SCRIPT="${SOMBREADO_DEPLOY_LIB}/deploy-release.sh"
if [[ ! -x "${DEPLOY_SCRIPT}" ]]; then
  echo "root-owned deploy script missing or not executable: ${DEPLOY_SCRIPT}" >&2
  echo "re-run deploy/bootstrap-vm.sh as root" >&2
  exit 1
fi

export RELEASE_SHA
exec "${DEPLOY_SCRIPT}"
