# Runtime secrets/settings for the Oracle VM.
# Install as /etc/sombreado/env (mode 0640, owned by root:sombreado).
# GitHub Actions must not hold these values — only deploy credentials.

# Neon/PostGIS Generation Store (Runtime Secret).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Browser origins (JSON array).
CORS_ORIGINS=["https://app.example.com"]

LOG_LEVEL=INFO

# Generation Store Backup → Oracle Object Storage (S3 Compatibility API).
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OBJECT_STORAGE_S3_BUCKET=sombreado-backups
OBJECT_STORAGE_S3_ACCESS_KEY=
OBJECT_STORAGE_S3_SECRET_KEY=
OBJECT_STORAGE_S3_REGION=sa-saopaulo-1
BACKUP_WORK_DIR=/var/lib/sombreado/backup-work
BACKUP_ASIDE_DIR=/var/lib/sombreado/backup-aside
BACKUP_RETAIN=7
BACKUP_KEY_PREFIX=sombreado-routes

# Route candidate / advice defaults (optional overrides).
ROUTE_CANDIDATE_NEARBY_RADIUS_METERS=1200
ROUTE_CANDIDATE_NEARBY_LIMIT=5
ROUTE_CANDIDATE_SEARCH_LIMIT=8
OFF_ROUTE_THRESHOLD_METERS=75
NOMINAL_BUS_SPEED_KMH=18
