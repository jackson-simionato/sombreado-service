# PARKED / historical (ADR 0004 superseded by ADR 0005). Not the production deploy path.
[Unit]
Description=Daily Sombreado Consórcio scrape timer

[Timer]
# Off-peak America/Sao_Paulo; host timezone should match production region.
OnCalendar=*-*-* 03:30:00
Persistent=true
Unit=sombreado-scrape.service

[Install]
WantedBy=timers.target
