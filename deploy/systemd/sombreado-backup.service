[Unit]
Description=Sombreado Service Generation Store backup (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sombreado
Group=sombreado
WorkingDirectory=/opt/sombreado/current
EnvironmentFile=/etc/sombreado/env
Environment=PATH=/opt/sombreado/current/.venv/bin:/usr/bin
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/sombreado
ExecStart=/opt/sombreado/current/.venv/bin/sombreado-scrape backup
TimeoutStartSec=30min
Nice=10
