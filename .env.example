# Copy this file to .env and adjust the values for your environment.

# Optional legacy PostGIS URL for non-passenger helpers only. Not used by the API runtime.
# DATABASE_URL=postgresql+asyncpg://user:change-me@localhost:5432/legacy

# Service-owned SQLite generation store (API + scrape + backup).
# Local default below; production uses /var/lib/sombreado/routes.sqlite (see deploy/env.example).
SQLITE_DATABASE_PATH=data/sombreado.sqlite

# Generation Store Backup (CLI: sombreado-scrape backup / restore).
# directory = local stand-in; s3 = Oracle Object Storage S3 Compatibility API.
OBJECT_STORAGE_BACKEND=directory
OBJECT_STORAGE_DIRECTORY=data/object-storage
# OBJECT_STORAGE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# OBJECT_STORAGE_S3_BUCKET=sombreado-backups
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
# OBJECT_STORAGE_S3_REGION=sa-saopaulo-1
BACKUP_WORK_DIR=data/backup-work
BACKUP_ASIDE_DIR=data/backup-aside
BACKUP_RETAIN=7
BACKUP_KEY_PREFIX=sombreado-routes

# Must be a JSON array of browser origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

LOG_LEVEL=INFO

# Nearby stop search defaults.
NEARBY_RADIUS_METERS=100
NEARBY_LIMIT=10

# Route candidate search defaults.
ROUTE_CANDIDATE_NEARBY_RADIUS_METERS=1200
ROUTE_CANDIDATE_NEARBY_LIMIT=5
ROUTE_CANDIDATE_SEARCH_LIMIT=8

# Route guidance defaults.
OFF_ROUTE_THRESHOLD_METERS=75
NOMINAL_BUS_SPEED_KMH=18
