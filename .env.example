# Copy this file to .env and adjust the values for your environment.

# Use the read-only service database role; do not use the migration/owner role.
DATABASE_URL=postgresql+asyncpg://sombreado_service_reader:change-me@localhost:5432/consorcio_fenix

# Service-owned SQLite generation store (fixture publish / upcoming scrape).
# Passenger API still reads PostGIS until cutover.
SQLITE_DATABASE_PATH=data/sombreado.sqlite

# Must be a JSON array of browser origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

LOG_LEVEL=INFO

# Nearby stop search defaults.
NEARBY_RADIUS_METERS=100
NEARBY_LIMIT=10

# Route candidate search defaults.
ROUTE_CANDIDATE_NEARBY_RADIUS_METERS=1200
ROUTE_CANDIDATE_NEARBY_LIMIT=5
ROUTE_CANDIDATE_SEARCH_LIMIT=8

# Route guidance defaults.
OFF_ROUTE_THRESHOLD_METERS=75
NOMINAL_BUS_SPEED_KMH=18
